{
  "name": "@opendesign/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "AI-native general design desktop client",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:protected": "vite build --mode protected",
    "package:dir": "pnpm build:protected && electron-builder --dir --publish never",
    "package:mac": "pnpm build:protected && electron-builder --mac --publish never",
    "package:win": "pnpm build:protected && electron-builder --win --publish never",
    "preview": "vite preview",
    "smoke:agent": "OPENDESIGN_AGENT_SMOKE=1 electron out/main/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opendesign/agent-contracts": "workspace:*",
    "@opendesign/agent-runtime": "workspace:*",
    "@opendesign/design-capabilities": "workspace:*",
    "@opendesign/design-contracts": "workspace:*",
    "@opendesign/editor-runtime": "workspace:*",
    "@opendesign/leafer-engine": "workspace:*",
    "@opendesign/model-gateway": "workspace:*",
    "@opendesign/session-store": "workspace:*",
    "@opendesign/ui": "workspace:*",
    "@opendesign/workspace-contracts": "workspace:*",
    "mammoth": "1.12.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "unpdf": "1.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "bytenode": "1.6.0",
    "electron": "^43.3.0",
    "electron-builder": "26.15.3",
    "happy-dom": "^20.0.11",
    "typescript": "catalog:",
    "vite": "^8.2.1",
    "vite-plugin-electron": "1.1.1",
    "vitest": "catalog:"
  }
}

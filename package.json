{
  "name": "open-design",
  "version": "0.0.0",
  "private": true,
  "description": "AI-native general design desktop client",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "pnpm": {
    "overrides": {
      "@iconify/json": "2.2.512"
    }
  },
  "scripts": {
    "agent-core:check": "node scripts/verify-agent-core-boundary.mjs",
    "architecture:check": "node --test scripts/workspace-path.test.mjs && node scripts/verify-architecture-boundaries.mjs",
    "build": "pnpm -r --if-present build",
    "capabilities:check": "node scripts/generate-capability-doc.mjs --check",
    "capabilities:generate": "node scripts/generate-capability-doc.mjs",
    "dev": "pnpm --filter @opendesign/desktop dev",
    "fixtures:check": "node scripts/generate-professional-fixtures.mjs --check",
    "fixtures:generate": "node scripts/generate-professional-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run && pnpm --filter @opendesign/desktop test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verification:check": "node scripts/verification-facts.mjs --check",
    "verification:generate": "node scripts/verification-facts.mjs --write",
    "verify": "pnpm format:check && pnpm architecture:check && pnpm agent-core:check && pnpm capabilities:check && pnpm fixtures:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verification:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.3",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  }
}

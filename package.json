{
  "name": "open-design",
  "version": "0.0.0",
  "private": true,
  "description": "AI-native general design desktop client",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "pnpm": {
    "overrides": {
      "@iconify/json": "2.2.512"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "capabilities:generate": "node scripts/generate-capability-doc.mjs",
    "dev": "pnpm --filter @opendesign/desktop dev",
    "evaluation:check": "node --test scripts/design-evaluation.test.mjs && node scripts/design-evaluation.mjs check",
    "fixtures:generate": "node scripts/generate-professional-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "vitest run && pnpm --filter @opendesign/desktop test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.3",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml,css,scss}": "prettier --check"
  }
}

{
  "version": 2,
  "desktopLayers": {
    "main": {
      "root": "apps/desktop/src/main",
      "forbiddenRelativeLayers": ["agent", "preload", "renderer"]
    },
    "renderer": {
      "root": "apps/desktop/src/renderer",
      "forbiddenBuiltins": ["electron", "node:"],
      "forbiddenRelativeLayers": ["agent", "main", "preload"]
    },
    "shared": {
      "root": "apps/desktop/src/shared",
      "forbiddenBuiltins": ["electron", "node:"],
      "forbiddenRelativeLayers": ["agent", "main", "preload", "renderer"]
    },
    "preload": {
      "root": "apps/desktop/src/preload",
      "allowedBuiltins": ["electron"],
      "forbiddenRelativeLayers": ["agent", "main", "renderer"]
    },
    "agent": {
      "root": "apps/desktop/src/agent",
      "forbiddenBuiltins": ["electron"],
      "forbiddenRelativeLayers": ["main", "preload", "renderer"]
    }
  },
  "workspaceDependencies": {
